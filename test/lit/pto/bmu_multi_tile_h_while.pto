// A5 + BMU multi-buffer inside an scf.while. The slot's lifetime closes within
// each iteration, so the H path materializes per-advance (§4.6 a-1): a
// bmu_alloc/free pair inside the loop body (alloc on MTE2, free on MTE3), not
// one function-scope allocation. The dedicated IR-level check is in
// bmu_multi_tile_per_advance.pto; this test pins the emitted intrinsics.

// RUN: ptoas --pto-arch=a5 --pto-uses-bmu --enable-insert-sync %s -o - 2>&1 | FileCheck %s

// CHECK: ubuf_alloc<PIPE_MTE2, 0>
// CHECK: ubuf_free<PIPE_MTE3>

module {
  func.func @while_loop(%gm : memref<16x16xf16, #pto.address_space<gm>>,
                        %n : index) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %mb = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
    %r = scf.while (%i = %c0) : (index) -> index {
      %cond = arith.cmpi slt, %i, %n : index
      scf.condition(%cond) %i : index
    } do {
    ^bb0(%i: index):
      %k = arith.remui %i, %c2 : index
      %s = pto.multi_tile_get %mb[%k]
          : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
         -> !pto.tile_buf<vec, 16x16xf16>
      pto.tload ins(%gm : memref<16x16xf16, #pto.address_space<gm>>)
                outs(%s : !pto.tile_buf<vec, 16x16xf16>)
      pto.tadd ins(%s, %s : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
               outs(%s : !pto.tile_buf<vec, 16x16xf16>)
      %ni = arith.addi %i, %c1 : index
      scf.yield %ni : index
    }
    return
  }
}
