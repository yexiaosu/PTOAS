// BMU design §4.8d, skip-tier reachability under consumer-pipe frees.
//
// The §4.8d "skip" tier fires only when P_used is a subset of P_freed, i.e.
// every used pipe is drained by a trailing bmu_free. But a BMU free rides the
// buffer's *consumer* pipe (§5.4: vec -> PIPE_MTE3), while a buffer is always
// first written on a *producer* pipe (vec <- PIPE_MTE2 load / PIPE_V compute).
// Producer != consumer, so the free pipe is disjoint from at least the producer
// pipe and P_used can never be a subset of P_freed. The skip tier is therefore
// unreachable for real buffers; disjoint coverage falls through to the full
// PIPE_ALL clean barrier (deferred, tagged auto_sync_tail_barrier).
//
// Here both tloads write on PIPE_MTE2 and the free drains PIPE_MTE3; the sets
// are disjoint, so we keep the full tail barrier rather than skipping.

// RUN: ptoas --pto-arch=a5 --pto-uses-bmu --enable-insert-sync --mlir-print-ir-after=pto-insert-sync %s 2>&1 1>/dev/null | FileCheck %s

// CHECK-LABEL: func.func @only_mte2
// CHECK: pto.bmu_free <vec>, <PIPE_MTE3>
// CHECK: pto.barrier <PIPE_ALL> {pto.auto_sync_tail_barrier}

module {
  func.func @only_mte2(%gm0 : memref<16x16xf16, #pto.address_space<gm>>,
                       %gm1 : memref<16x16xf16, #pto.address_space<gm>>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %mb = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
    %s0 = pto.multi_tile_get %mb[%c0]
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
       -> !pto.tile_buf<vec, 16x16xf16>
    %s1 = pto.multi_tile_get %mb[%c1]
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
       -> !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%gm0 : memref<16x16xf16, #pto.address_space<gm>>)
              outs(%s0 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%gm1 : memref<16x16xf16, #pto.address_space<gm>>)
              outs(%s1 : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}
