// RUN: not ptoas %s 2>&1 | FileCheck %s

// A BMU free must be issued on the last-consumer pipe that reads the region
// (BMU.md §5.4), or on the scalar pipe as a fallback. MTE2 only writes UB
// (GM->UB), never reads it, so a drain there does not wait for the real
// consumers and is rejected.
module {
  func.func @bad_free_pipe() {
    %n = arith.constant 4 : index
    %b = pto.bmu_alloc #pto.address_space<vec>, #pto.pipe<PIPE_MTE2>, segm 0, count %n
        : index -> i64
    pto.bmu_free #pto.address_space<vec>, #pto.pipe<PIPE_MTE2>, base %b, count %n
        : i64, index
    return
  }
}

// CHECK: 'pto.bmu_free' op pipe PIPE_MTE2 is not valid for a BMU free on buffer kind vec
// CHECK-SAME: expected one of: PIPE_S, PIPE_V, PIPE_MTE3
