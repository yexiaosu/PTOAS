// The optional multi_tile_buf `placement` field (auto|static|bmu) parses and
// prints. The default (auto) is kept implicit so the common form stays compact.

// RUN: ptoas --mlir-print-ir-before=pto-view-to-memref --pto-arch=a5 %s 2>&1 1>/dev/null | FileCheck %s

module {
  func.func @placement_forms() {
    // CHECK: pto.alloc_multi_tile : !pto.multi_tile_buf<!pto.tile_buf<vec, 16x16xf16>, count=2>
    %auto = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2>

    // CHECK: pto.alloc_multi_tile : !pto.multi_tile_buf<!pto.tile_buf<vec, 16x16xf16>, count=2, placement=static>
    %static = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=static>

    // CHECK: pto.alloc_multi_tile : !pto.multi_tile_buf<!pto.tile_buf<vec, 16x16xf16>, count=2, placement=bmu>
    %bmu = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
    return
  }
}
