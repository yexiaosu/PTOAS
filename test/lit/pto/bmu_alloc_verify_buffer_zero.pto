// verifyBmuBufferKind whitelists the on-chip BMU scopes, so the default/none
// address space (`zero`) is rejected just like GM. This pins that the verifier
// is a whitelist and does not silently treat a non-BMU space as UB.

// RUN: not ptoas %s 2>&1 | FileCheck %s

module {
  func.func @zero_buffer() {
    %n = arith.constant 4 : index
    %b = pto.bmu_alloc #pto.address_space<zero>, #pto.pipe<PIPE_MTE2>, segm 0, count %n
        : index -> i64
    return
  }
}

// CHECK: buffer kind must be an on-chip BMU local-memory address space
// CHECK-SAME: got zero
