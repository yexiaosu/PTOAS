// RUN: not ptoas %s 2>&1 | FileCheck %s

// Segment tails are in slice units and must be monotonically non-decreasing.
module {
  func.func @bad_tails() {
    pto.bmu_config #pto.address_space<vec> tails = [8, 4, 4, 4]
    return
  }
}

// CHECK: segment tails must be non-decreasing
