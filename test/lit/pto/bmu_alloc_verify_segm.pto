// RUN: not ptoas %s 2>&1 | FileCheck %s

// A BMU buffer kind has at most 4 segments, so segm must be in [0, 3].
module {
  func.func @bad_segm() {
    %n = arith.constant 4 : index
    %b = pto.bmu_alloc #pto.address_space<vec>, #pto.pipe<PIPE_MTE2>, segm 5, count %n
        : index -> i64
    return
  }
}

// CHECK: segm must be in [0, 3]
