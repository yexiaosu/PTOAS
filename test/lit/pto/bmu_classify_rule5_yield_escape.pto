// BMU design §4.5 rule 5 guard: a buffer allocated in an scf.if branch but
// yielded out through the scf.if result escapes the branch and outlives it, so
// it is NOT branch-local and must stay S. Marking it D would make pto-plan-bmu-
// layout free it before the scf.yield and use-after-free the result.

// RUN: ptoas --pto-arch=a5 --pto-uses-bmu --mlir-print-ir-after=pto-classify-buffers %s 2>&1 1>/dev/null | FileCheck %s

// CHECK-NOT: pto.plan_class

module {
  func.func @yielded(%gm0 : memref<16x16xf16, #pto.address_space<gm>>, %cond : i1) {
    %r = scf.if %cond -> (memref<16x16xf16, #pto.address_space<vec>>) {
      %a = memref.alloc() : memref<16x16xf16, #pto.address_space<vec>>
      pto.tload ins(%gm0 : memref<16x16xf16, #pto.address_space<gm>>)
                outs(%a : memref<16x16xf16, #pto.address_space<vec>>)
      scf.yield %a : memref<16x16xf16, #pto.address_space<vec>>
    } else {
      %b = memref.alloc() : memref<16x16xf16, #pto.address_space<vec>>
      scf.yield %b : memref<16x16xf16, #pto.address_space<vec>>
    }
    return
  }
}
