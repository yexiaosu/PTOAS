// BMU design §4.7: S and BMU (H/D) allocs coexist in one buffer kind. The BMU
// dynamic segments occupy the low region [0, tail_seg3*slice); pto-plan-memory
// places the static ("S") allocs in the reserved tail above them by reducing
// the scope capacity to the tail and shifting every planned offset up by the
// BMU region size (= tail_seg3 * slice_size).
//
// Here one explicit-bmu multi-buffer (H) reserves 1 vec slice (2*512B <= 8KB),
// so tail_seg3 = 1 and the reserved-tail base is 1*8192 = 8192 bytes. The auto
// multi-buffer (S) would otherwise be planned at 0/512; instead it lands at
// 8192/8704, disjoint from the BMU segment.

// RUN: ptoas --pto-arch=a5 --pto-uses-bmu --mlir-print-ir-after=pto-plan-bmu-layout %s 2>&1 1>/dev/null | FileCheck %s

module {
  func.func @coexist(%gm0 : memref<16x16xf16, #pto.address_space<gm>>,
                     %gm1 : memref<16x16xf16, #pto.address_space<gm>>,
                     %gm2 : memref<16x16xf16, #pto.address_space<gm>>,
                     %gm3 : memref<16x16xf16, #pto.address_space<gm>>) {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    // H: explicit BMU multi-buffer -> BMU segment 0.
    %mbh = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
    %h0 = pto.multi_tile_get %mbh[%c0]
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
       -> !pto.tile_buf<vec, 16x16xf16>
    %h1 = pto.multi_tile_get %mbh[%c1]
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
       -> !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%gm0 : memref<16x16xf16, #pto.address_space<gm>>)
              outs(%h0 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%gm1 : memref<16x16xf16, #pto.address_space<gm>>)
              outs(%h1 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tadd ins(%h0, %h1 : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
             outs(%h0 : !pto.tile_buf<vec, 16x16xf16>)
    // S: auto small multi-buffer -> reserved static tail.
    %mbs = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
    %s0 = pto.multi_tile_get %mbs[%c0]
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
       -> !pto.tile_buf<vec, 16x16xf16>
    %s1 = pto.multi_tile_get %mbs[%c1]
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2>
       -> !pto.tile_buf<vec, 16x16xf16>
    pto.tload ins(%gm2 : memref<16x16xf16, #pto.address_space<gm>>)
              outs(%s0 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tload ins(%gm3 : memref<16x16xf16, #pto.address_space<gm>>)
              outs(%s1 : !pto.tile_buf<vec, 16x16xf16>)
    pto.tadd ins(%s0, %s1 : !pto.tile_buf<vec, 16x16xf16>, !pto.tile_buf<vec, 16x16xf16>)
             outs(%s0 : !pto.tile_buf<vec, 16x16xf16>)
    return
  }
}

// S-first pipeline: plan-memory plans S with liveness reuse (two 512B tiles
// share via liveness → S peak = 1024B = 1 slice) then sets tail_seg3 = 47.
// S addresses are shifted to [47*8192, total): 385024 / 385536.
// plan-bmu-layout then carves the H group in [0, 47*8192).
// CHECK: pto.bmu_config <vec> tails = [1, 1, 1, 1]
// CHECK: pto.bmu_alloc <vec>, <PIPE_MTE2>, segm 0
// S slots are shifted into the reserved tail: tail_seg3=47, base = 47*8192 = 385024.
// CHECK-DAG: arith.constant 385024 : i64
// CHECK-DAG: arith.constant 385536 : i64
