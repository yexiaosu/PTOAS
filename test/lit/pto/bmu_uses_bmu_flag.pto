// The --pto-uses-bmu flag sets the pto.uses_bmu module attribute. On a5 it is
// honored; on a3 it is forced false; absent the flag the attribute is omitted.

// RUN: ptoas --emit-pto-ir --pto-arch=a5 --pto-uses-bmu %s 2>&1 | FileCheck %s --check-prefix=A5ON
// RUN: ptoas --emit-pto-ir --pto-arch=a3 --pto-uses-bmu %s 2>&1 | FileCheck %s --check-prefix=A3OFF
// RUN: ptoas --emit-pto-ir --pto-arch=a5 %s 2>&1 | FileCheck %s --check-prefix=A5NONE

// A5ON: module attributes {{.*}}pto.uses_bmu = true
// A3OFF: module attributes {{.*}}pto.uses_bmu = false
// A5NONE-NOT: pto.uses_bmu

module {
  func.func @f() {
    return
  }
}
