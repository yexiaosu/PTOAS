// placement=bmu forces the A5 BMU dynamic-shell layout and is rejected on a3.

// RUN: not ptoas --pto-arch=a3 %s 2>&1 | FileCheck %s

module {
  func.func @bmu_on_a3() {
    %mb = pto.alloc_multi_tile
        : !pto.multi_tile_buf<vec, 16x16xf16, count=2, placement=bmu>
    return
  }
}

// CHECK: placement=bmu requires --pto-arch=a5
