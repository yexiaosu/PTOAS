// BMU.md §3.1: 0 <= tail_seg0 <= tail_seg1 <= tail_seg2 <= tail_seg3 <=
// total_slices. UB (vec) has 48 slices, so tail_seg3 = 100 is out of range.

// RUN: not ptoas %s 2>&1 | FileCheck %s

module {
  func.func @over_total_slices() {
    pto.bmu_config <vec> tails = [0, 0, 0, 100]
    return
  }
}

// CHECK: tail_seg3=100 exceeds the total slice count (48) of buffer kind vec
