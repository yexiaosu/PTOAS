// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=on' > %t 2> %t.diag
// RUN: FileCheck %s --check-prefix=ORDER < %t
// RUN: FileCheck %s --check-prefix=FALLBACK < %t.diag
// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=analyze' > %t.analyze-ir 2> %t.analyze
// RUN: FileCheck %s --check-prefix=ANALYZE < %t.analyze

// ORDER-LABEL: func.func @unknown_then_known
// ORDER: pto.vsub
// ORDER: pto.vmin
// ORDER-NEXT: pto.vmin
// ORDER-NEXT: pto.vmax
// ORDER-NEXT: pto.vmax

// FALLBACK: remark: VPTO scheduler skipped block 0 region 0 because original-index=0 op=pto.vsub has an unknown scheduling class
// FALLBACK-NOT: skipped block 1

// ANALYZE: vpto-scheduler: block=0 regions=1
// ANALYZE: vpto-scheduler: region=0
// ANALYZE-SAME: known-classes=0 unknown-classes=1
// ANALYZE: vpto-scheduler: node=0
// ANALYZE-SAME: known=false
// ANALYZE: vpto-scheduler: pressure node=0
// ANALYZE: vpto-scheduler: block=1 regions=1
// ANALYZE: vpto-scheduler: pressure node=0
// ANALYZE-NOT: VPTO scheduler skipped
// ANALYZE-NOT: schedule-result
// ANALYZE: vpto-scheduler: coverage
// ANALYZE-NOT: timeline cycle=

module attributes {pto.target_arch = "a5"} {
  func.func @unknown_then_known(%x0: !pto.vreg<64xf32>,
                                %x1: !pto.vreg<64xf32>,
                                %active: !pto.mask<b32>) {
    pto.vecscope {
      %unknown = pto.vsub %x0, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    }
    pto.vecscope {
      %a0 = pto.vmin %x0, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %b0 = pto.vmax %a0, %x1, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %a1 = pto.vmin %x1, %x0, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %b1 = pto.vmax %a1, %x0, %active : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
    }
    return
  }
}
