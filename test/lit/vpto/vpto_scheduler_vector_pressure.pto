// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=analyze' > /dev/null 2> %t.analyze
// RUN: FileCheck %s --check-prefix=ANALYZE < %t.analyze
// RUN: pto-test-opt %s '-pto-vpto-scheduler=mode=on trace=true' > %t.on 2> %t.trace
// RUN: FileCheck %s --check-prefix=ORDER < %t.on
// RUN: FileCheck %s --check-prefix=ON < %t.trace

// Thirty-four independent producer/consumer chains all contribute to the
// stored reduction. The input order deliberately groups real producers before
// their consumers; there are no unused values or synthetic dependencies.

// ANALYZE: vpto-scheduler: function=vector_pressure mode=analyze
