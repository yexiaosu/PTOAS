// Real-shape VPTO equivalent of mouliangyu/PTOAS#574's single-group
// topk_gate_vf explicit hand-mapped AABBCC reproducer: N=4, E=384, K=9, token_tile=4.
module attributes {pto.target_arch = "a5", pto.kernel_kind = #pto.kernel_kind<vector>} {
  func.func @topk_gate_aabbcc_scheduler_kernel(%scores: !pto.ptr<f32, gm>,
                                                  %topk_idx: !pto.ptr<si32, gm>) attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c3 = arith.constant 3 : index
    %c4 = arith.constant 4 : index
    %c5 = arith.constant 5 : index
    %c6 = arith.constant 6 : index
    %c7 = arith.constant 7 : index
    %c8 = arith.constant 8 : index
    %c9 = arith.constant 9 : index
    %c18 = arith.constant 18 : index
    %c27 = arith.constant 27 : index
    %c64 = arith.constant 64 : index
    %c128 = arith.constant 128 : index
    %c192 = arith.constant 192 : index
    %c256 = arith.constant 256 : index
    %c320 = arith.constant 320 : index
    %c384 = arith.constant 384 : index
    %c768 = arith.constant 768 : index
    %c1152 = arith.constant 1152 : index
    %c0_i32 = arith.constant 0 : i32
    %c64_i32 = arith.constant 64 : i32
    %c128_i32 = arith.constant 128 : i32
    %c192_i32 = arith.constant 192 : i32
    %c256_i32 = arith.constant 256 : i32
    %c320_i32 = arith.constant 320 : i32
    %c384_i32 = arith.constant 384 : i32
    %c2147483647_i32 = arith.constant 2147483647 : i32
    %neg_inf = arith.constant -1.000000e+30 : f32
    %c0_i64 = arith.constant 0 : i64
    %c1_i64 = arith.constant 1 : i64
    %c36_i64 = arith.constant 36 : i64
    %c1536_i64 = arith.constant 1536 : i64
    %c6144_i64 = arith.constant 6144 : i64
    %c6400_i64 = arith.constant 6400 : i64
    %c6656_i64 = arith.constant 6656 : i64
    %c6912_i64 = arith.constant 6912 : i64

    %gm_score1 = pto.addptr %scores, %c384 : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>
    %gm_score2 = pto.addptr %scores, %c768 : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>
    %gm_score3 = pto.addptr %scores, %c1152 : !pto.ptr<f32, gm> -> !pto.ptr<f32, gm>
    %gm_out1 = pto.addptr %topk_idx, %c9 : !pto.ptr<si32, gm> -> !pto.ptr<si32, gm>
    %gm_out2 = pto.addptr %topk_idx, %c18 : !pto.ptr<si32, gm> -> !pto.ptr<si32, gm>
    %gm_out3 = pto.addptr %topk_idx, %c27 : !pto.ptr<si32, gm> -> !pto.ptr<si32, gm>
    %ub_score0 = pto.castptr %c0_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_score1 = pto.castptr %c1536_i64 : i64 -> !pto.ptr<f32, ub>
    %c3072_i64 = arith.constant 3072 : i64
    %c4608_i64 = arith.constant 4608 : i64
    %ub_score2 = pto.castptr %c3072_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_score3 = pto.castptr %c4608_i64 : i64 -> !pto.ptr<f32, ub>
    %ub_out0 = pto.castptr %c6144_i64 : i64 -> !pto.ptr<si32, ub>
    %ub_out1 = pto.castptr %c6400_i64 : i64 -> !pto.ptr<si32, ub>
    %ub_out2 = pto.castptr %c6656_i64 : i64 -> !pto.ptr<si32, ub>
    %ub_out3 = pto.castptr %c6912_i64 : i64 -> !pto.ptr<si32, ub>

    pto.mte_gm_ub %scores, %ub_score0, %c0_i64, %c1536_i64
      nburst(%c1_i64, %c1536_i64, %c1536_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %gm_score1, %ub_score1, %c0_i64, %c1536_i64
      nburst(%c1_i64, %c1536_i64, %c1536_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %gm_score2, %ub_score2, %c0_i64, %c1536_i64
      nburst(%c1_i64, %c1536_i64, %c1536_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.mte_gm_ub %gm_score3, %ub_score3, %c0_i64, %c1536_i64
      nburst(%c1_i64, %c1536_i64, %c1536_i64)
      : !pto.ptr<f32, gm>, !pto.ptr<f32, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]

    // Source order mirrors the hand-written CCE AABBCC pair schedule.
    // Scheduler stays off so the control preserves this exact order.
    pto.vecscope {
      %active_p0 = pto.pset_b32 "PAT_ALL" : !pto.mask<b32>
      %zero_p0 = pto.vdup %c0_i32, %active_p0 : i32, !pto.mask<b32> -> !pto.vreg<64xsi32>
      pto.vsts %zero_p0, %ub_out0[%c0], %active_p0 : !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, !pto.mask<b32>
      pto.vsts %zero_p0, %ub_out1[%c0], %active_p0 : !pto.vreg<64xsi32>, !pto.ptr<si32, ub>, !pto.mask<b32>
      %neg_inf_p0 = pto.vdup %neg_inf, %active_p0 : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      %int_max_p0 = pto.vdup %c2147483647_i32, %active_p0 : i32, !pto.mask<b32> -> !pto.vreg<64xsi32>
      %num_exp_p0 = pto.vdup %c384_i32, %active_p0 : i32, !pto.mask<b32> -> !pto.vreg<64xsi32>
      %score_p0_t0_c5_raw = pto.vlds %ub_score0[%c320] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %score_p0_t0_c4_raw = pto.vlds %ub_score0[%c256] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %score_p0_t0_c3_raw = pto.vlds %ub_score0[%c192] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %score_p0_t0_c2_raw = pto.vlds %ub_score0[%c128] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %score_p0_t0_c1_raw = pto.vlds %ub_score0[%c64] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %score_p0_t0_c0_raw = pto.vlds %ub_score0[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %score_p0_t1_c5_raw = pto.vlds %ub_score1[%c320] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %index_p0_5 = pto.vci %c320_i32 {order = "ASC"} : i32 -> !pto.vreg<64xsi32>
      %score_p0_t1_c4_raw = pto.vlds %ub_score1[%c256] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %index_p0_4 = pto.vci %c256_i32 {order = "ASC"} : i32 -> !pto.vreg<64xsi32>
      %score_p0_t1_c3_raw = pto.vlds %ub_score1[%c192] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %index_p0_3 = pto.vci %c192_i32 {order = "ASC"} : i32 -> !pto.vreg<64xsi32>
      %score_p0_t1_c2_raw = pto.vlds %ub_score1[%c128] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %index_p0_2 = pto.vci %c128_i32 {order = "ASC"} : i32 -> !pto.vreg<64xsi32>
      %score_p0_t1_c1_raw = pto.vlds %ub_score1[%c64] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %index_p0_1 = pto.vci %c64_i32 {order = "ASC"} : i32 -> !pto.vreg<64xsi32>
      %score_p0_t1_c0_raw = pto.vlds %ub_score1[%c0] : !pto.ptr<f32, ub> -> !pto.vreg<64xf32>
      %index_p0_0 = pto.vci %c0_i32 {order = "ASC"} : i32 -> !pto.vreg<64xsi32>
      %pad_p0_t0_c5 = pto.vcmp %index_p0_5, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t0_c5_k0 = pto.vsel %score_p0_t0_c5_raw, %neg_inf_p0, %pad_p0_t0_c5 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t0_c4 = pto.vcmp %index_p0_4, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t0_c4_k0 = pto.vsel %score_p0_t0_c4_raw, %neg_inf_p0, %pad_p0_t0_c4 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t0_c3 = pto.vcmp %index_p0_3, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t0_c3_k0 = pto.vsel %score_p0_t0_c3_raw, %neg_inf_p0, %pad_p0_t0_c3 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t0_c2 = pto.vcmp %index_p0_2, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t0_c2_k0 = pto.vsel %score_p0_t0_c2_raw, %neg_inf_p0, %pad_p0_t0_c2 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t0_c1 = pto.vcmp %index_p0_1, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t0_c1_k0 = pto.vsel %score_p0_t0_c1_raw, %neg_inf_p0, %pad_p0_t0_c1 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t0_c0 = pto.vcmp %index_p0_0, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t0_c0_k0 = pto.vsel %score_p0_t0_c0_raw, %neg_inf_p0, %pad_p0_t0_c0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t1_c5 = pto.vcmp %index_p0_5, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t1_c5_k0 = pto.vsel %score_p0_t1_c5_raw, %neg_inf_p0, %pad_p0_t1_c5 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t1_c4 = pto.vcmp %index_p0_4, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t1_c4_k0 = pto.vsel %score_p0_t1_c4_raw, %neg_inf_p0, %pad_p0_t1_c4 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t1_c3 = pto.vcmp %index_p0_3, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t1_c3_k0 = pto.vsel %score_p0_t1_c3_raw, %neg_inf_p0, %pad_p0_t1_c3 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t1_c2 = pto.vcmp %index_p0_2, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t1_c2_k0 = pto.vsel %score_p0_t1_c2_raw, %neg_inf_p0, %pad_p0_t1_c2 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t1_c1 = pto.vcmp %index_p0_1, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t1_c1_k0 = pto.vsel %score_p0_t1_c1_raw, %neg_inf_p0, %pad_p0_t1_c1 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %pad_p0_t1_c0 = pto.vcmp %index_p0_0, %num_exp_p0, %active_p0, "lt" : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.mask<b32>
      %score_p0_t1_c0_k0 = pto.vsel %score_p0_t1_c0_raw, %neg_inf_p0, %pad_p0_t1_c0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_init = pto.vdup %neg_inf, %active_p0 : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_init = pto.vdup %neg_inf, %active_p0 : f32, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_c5 = pto.vmax %acc_p0_t0_k0_init, %score_p0_t0_c5_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_c5 = pto.vmax %acc_p0_t1_k0_init, %score_p0_t1_c5_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_c4 = pto.vmax %acc_p0_t0_k0_c5, %score_p0_t0_c4_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_c4 = pto.vmax %acc_p0_t1_k0_c5, %score_p0_t1_c4_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_c3 = pto.vmax %acc_p0_t0_k0_c4, %score_p0_t0_c3_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_c3 = pto.vmax %acc_p0_t1_k0_c4, %score_p0_t1_c3_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_c2 = pto.vmax %acc_p0_t0_k0_c3, %score_p0_t0_c2_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_c2 = pto.vmax %acc_p0_t1_k0_c3, %score_p0_t1_c2_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_c1 = pto.vmax %acc_p0_t0_k0_c2, %score_p0_t0_c1_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_c1 = pto.vmax %acc_p0_t1_k0_c2, %score_p0_t1_c1_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t0_k0_c0 = pto.vmax %acc_p0_t0_k0_c1, %score_p0_t0_c0_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %acc_p0_t1_k0_c0 = pto.vmax %acc_p0_t1_k0_c1, %score_p0_t1_c0_k0, %active_p0 : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %max_p0_t0_k0_lane = pto.vcmax %acc_p0_t0_k0_c0, %active_p0 : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %max_p0_t1_k0_lane = pto.vcmax %acc_p0_t1_k0_c0, %active_p0 : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %max_p0_t0_k0 = pto.vdup %max_p0_t0_k0_lane, %active_p0 {position = "LOWEST"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %max_p0_t1_k0 = pto.vdup %max_p0_t1_k0_lane, %active_p0 {position = "LOWEST"} : !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.vreg<64xf32>
      %match_p0_t0_k0_c5 = pto.vcmp %score_p0_t0_c5_k0, %max_p0_t0_k0, %active_p0, "eq" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %candidate_p0_t0_k0_c5 = pto.vsel %index_p0_5, %int_max_p0, %match_p0_t0_k0_c5 : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
      %match_p0_t0_k0_c4 = pto.vcmp %score_p0_t0_c4_k0, %max_p0_t0_k0, %active_p0, "eq" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %candidate_p0_t0_k0_c4 = pto.vsel %index_p0_4, %int_max_p0, %match_p0_t0_k0_c4 : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
      %match_p0_t0_k0_c3 = pto.vcmp %score_p0_t0_c3_k0, %max_p0_t0_k0, %active_p0, "eq" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %candidate_p0_t0_k0_c3 = pto.vsel %index_p0_3, %int_max_p0, %match_p0_t0_k0_c3 : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
      %match_p0_t0_k0_c2 = pto.vcmp %score_p0_t0_c2_k0, %max_p0_t0_k0, %active_p0, "eq" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
      %candidate_p0_t0_k0_c2 = pto.vsel %index_p0_2, %int_max_p0, %match_p0_t0_k0_c2 : !pto.vreg<64xsi32>, !pto.vreg<64xsi32>, !pto.mask<b32> -> !pto.vreg<64xsi32>
      %match_p0_t0_k0_c1 = pto.vcmp %score_p0_t0_c1_k0, %max_p0_t0_k0, %active_p0, "eq" : !pto.vreg<64xf32>, !pto.vreg<64xf32>, !pto.mask<b32> -> !pto.mask<b32>
