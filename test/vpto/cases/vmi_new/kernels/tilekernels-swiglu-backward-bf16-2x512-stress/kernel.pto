          : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
      pto.vmi.vstore %x_grad_bf16_13, %ub_out[%c1344]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
      pto.vmi.vstore %y_grad_bf16_13, %ub_out[%c1856]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
      %x_grad_bf16_14 = pto.vmi.vcvt %x_grad_14 {saturate = "NOSAT"}
          : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
      %y_grad_bf16_14 = pto.vmi.vcvt %y_grad_14 {saturate = "NOSAT"}
          : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
      pto.vmi.vstore %x_grad_bf16_14, %ub_out[%c1408]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
      pto.vmi.vstore %y_grad_bf16_14, %ub_out[%c1920]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
      %x_grad_bf16_15 = pto.vmi.vcvt %x_grad_15 {saturate = "NOSAT"}
          : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
      %y_grad_bf16_15 = pto.vmi.vcvt %y_grad_15 {saturate = "NOSAT"}
          : !pto.vmi.vreg<64xf32> -> !pto.vmi.vreg<64xbf16>
      pto.vmi.vstore %x_grad_bf16_15, %ub_out[%c1472]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
      pto.vmi.vstore %y_grad_bf16_15, %ub_out[%c1984]
          : !pto.vmi.vreg<64xbf16>, !pto.ptr<bf16, ub>
    }

    pto.set_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.wait_flag["PIPE_V", "PIPE_MTE3", "EVENT_ID0"]
    pto.mte_ub_gm %ub_out, %out_gm, %c4096_i64
      nburst(%c1_i64, %c4096_i64, %c4096_i64)
      : !pto.ptr<bf16, ub>, !pto.ptr<bf16, gm>, i64, i64, i64, i64
    pto.barrier #pto.pipe<PIPE_ALL>
    return
  }
}
